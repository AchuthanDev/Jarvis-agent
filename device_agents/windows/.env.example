# Copy to .env on the Windows laptop. Do not commit .env.

JARVIS_SERVER_URL=http://192.168.x.x:8000
JARVIS_DEVICE_ID=
JARVIS_DEVICE_TOKEN=
JARVIS_DEVICE_NAME=My-Laptop

# Optional JSON file for additional allowlisted app aliases.
# Example JSON content:
# {
#   "obsidian": ["C:\\Users\\you\\AppData\\Local\\Obsidian\\Obsidian.exe"]
# }
JARVIS_WINDOWS_APPS_JSON=

# --- Voice client (Phase 5) ---
JARVIS_VOICE_ENABLED=true
JARVIS_WAKEWORD_ENABLED=false
JARVIS_WAKEWORD_PHRASE=hey jarvis
JARVIS_STT_PROVIDER=faster_whisper
JARVIS_STT_MODEL=base
JARVIS_TTS_PROVIDER=edge_tts
JARVIS_TTS_VOICE=en-US-GuyNeural
JARVIS_AUDIO_INPUT_DEVICE=
JARVIS_AUDIO_OUTPUT_DEVICE=
JARVIS_AUDIO_SAMPLE_RATE=16000
JARVIS_VAD_ENABLED=true
JARVIS_VAD_THRESHOLD=0.012
JARVIS_VAD_SILENCE_SECONDS=1.0
JARVIS_NO_SPEECH_TIMEOUT_SECONDS=8.0
JARVIS_MAX_RECORD_SECONDS=30.0
