# Copy to .env on the Windows laptop. Do not commit .env.

JARVIS_SERVER_URL=http://192.168.x.x:8000
JARVIS_DEVICE_ID=
JARVIS_DEVICE_TOKEN=
JARVIS_DEVICE_NAME=My-Laptop

# Optional JSON file for additional allowlisted app aliases.
# Example JSON content:
# {
#   "obsidian": ["C:\\Users\\you\\AppData\\Local\\Obsidian\\Obsidian.exe"]
# }
JARVIS_WINDOWS_APPS_JSON=
