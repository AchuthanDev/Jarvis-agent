# JARVIS configuration. Copy this file to `.env` and fill in real values.
# The `.env` file is gitignored — never commit secrets.

# --- Core ---
JARVIS_SECRET_KEY=change-me
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# Password used by the postgres container AND the asyncpg connection string.
POSTGRES_PASSWORD=change-me
# For local (non-Docker) runs. In Docker Compose this is overridden to point
# at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://jarvis:change-me@localhost:5432/jarvis

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider (Phase 2+) ---
# openai | gemini | groq | ollama | openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# Optional: custom OpenAI-compatible endpoint or Ollama host.
# e.g. LLM_BASE_URL=http://localhost:11434 for Ollama
LLM_BASE_URL=
# Sampling temperature (0.0–2.0, default 0.7) and optional max output tokens.
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=

# --- Device companions (Phase 4+) ---
# Used once to register Windows/Android/Linux companion agents.
DEVICE_REGISTRATION_SECRET=
DEVICE_COMMAND_TIMEOUT_SECONDS=20

# --- Home Assistant (Phase 8+) ---
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
